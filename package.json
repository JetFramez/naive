{
  "name": "@jetframez/notio",
  "version": "0.2.0",
  "description": "A TypeScript web framework on Express 5: a typed router, per-request context, unified errors, hooks, logging, config, and optional modules for auth, uploads, rate limiting, and OpenAPI.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "express",
    "framework",
    "typescript",
    "router",
    "openapi"
  ],
  "homepage": "https://jetframez.github.io/notio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JetFramez/notio.git",
    "directory": "packages/notio"
  },
  "bugs": {
    "url": "https://github.com/JetFramez/notio/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./upload": {
      "types": "./dist/upload.d.ts",
      "import": "./dist/upload.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit.d.ts",
      "import": "./dist/rate-limit.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.18",
    "busboy": "^1.6.0",
    "cookie": "^2.0.1",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "file-type": "^22.1.0",
    "jose": "^6.2.12",
    "keyv": "^5.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "optionalDependencies": {
    "@keyv/redis": "^5.1.6",
    "@node-rs/argon2": "^2.2.1"
  }
}
